{
  // Type-checks the TUI source files, which the host loads as source and the
  // main build leaves out.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["node"]
  },
  "include": ["sidebar.tsx"]
}
